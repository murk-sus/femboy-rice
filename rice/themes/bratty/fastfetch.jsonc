// Femboy Paws // Bratty — fastfetch (rice)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/femboychik/.local/share/rice/themes/bratty/fastfetch-logo.png",
    "type": "kitty",
    "height": 16,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "95",
      "title": "94"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#1;95}  {#0;94}femboy paws {#90}// {#95}bratty mode"
    },
    {
      "type": "custom",
      "format": "{#35}─────────────────────────────────────────"
    },
    {
      "type": "custom",
      "format": "{#95}MOOD      {#97}bratty  {#90}// headpats required"
    },
    {
      "type": "custom",
      "format": "{#95}OUTFIT    {#97}choker · thigh-highs · oversized hoodie"
    },
    {
      "type": "title",
      "key": "USER     "
    },
    {
      "type": "os",
      "key": "OS       "
    },
    {
      "type": "kernel",
      "key": "KERNEL   "
    },
    {
      "type": "packages",
      "key": "PACKAGES "
    },
    {
      "type": "shell",
      "key": "SHELL    "
    },
    {
      "type": "terminal",
      "key": "TERMINAL "
    },
    {
      "type": "wm",
      "key": "WM       "
    },
    {
      "type": "cpu",
      "key": "BRAIN    "
    },
    {
      "type": "gpu",
      "key": "SPARKLE  "
    },
    {
      "type": "memory",
      "key": "ATTENTION"
    },
    {
      "type": "uptime",
      "key": "BEING CUTE"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}